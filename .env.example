# Optional; set to your actual production URL before deploying (no trailing slash)
NEXT_PUBLIC_SITE_URL=
# Optional: exact public repo name; blank shows total public repository stars
NEXT_PUBLIC_GITHUB_REPO=
# Optional server-only GitHub API token for rate limits (never use NEXT_PUBLIC_)
GITHUB_TOKEN=
# Optional: email delivery; with no settings, contact form opens mail app
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: compatible realtime server you control
NEXT_PUBLIC_WS_URL=
# Optional: analytics you control, disabled by default
UMAMI_DOMAIN=
UMAMI_SITE_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_LEGACY_HOST=
